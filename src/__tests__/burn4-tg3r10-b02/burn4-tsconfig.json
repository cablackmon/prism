{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["jest", "node", "react", "react-dom"]
  },
  "include": ["./*.ts", "./*.tsx", "../../app/weekend/locations/*.ts", "../../app/weekend/locations/*.tsx"]
}
